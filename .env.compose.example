# Host paths are mounted into the container; do not use VAULT_PATH here.
HOST_VAULT_PATH=/absolute/path/to/your/Obsidian/vault
HOST_RULES_CONFIG_PATH=/absolute/path/to/your/config.json

# If folders inside your vault are symlinks pointing OUTSIDE the vault
# (e.g. MSFT -> ../.nb/MSFT), mounting only the vault leaves them dangling
# inside the container and those notes are never seen. Mount a parent
# directory that contains both the vault and the link targets instead:
#
# HOST_MOUNT_PATH=/Users/you/LocalDocs
# CONTAINER_MOUNT_PATH=/vaultroot
# CONTAINER_VAULT_PATH=/vaultroot/Notes

# Microsoft Graph application credentials
GRAPH_CLIENT_ID=your-app-client-id
GRAPH_TENANT_ID=your-tenant-id

# Optional sync behavior
ONEDRIVE_FOLDER=ObsidianPublished
HEALTH_PORT=8080
LOG_LEVEL=info
DEBOUNCE_DELAY=300

# Bind-mounted vaults on macOS/Windows do not deliver filesystem events into the
# container, so polling defaults to true for Compose. Set to false on Linux hosts.
WATCH_USE_POLLING=true
WATCH_POLL_INTERVAL=1000

# Optional: run a full sync on a fixed interval, in addition to (or instead of)
# watching. Empty means no schedule. Accepts ms, s, m, h, d — e.g. 15m, 1h, 1d.
# SYNC_SCHEDULE=1h
# Run once at startup rather than waiting a full interval (default true).
# SYNC_SCHEDULE_RUN_ON_START=true
# Skip a tick that lands while the previous run is still going (default true).
# SYNC_SCHEDULE_SKIP_IF_RUNNING=true
# Random 0..n milliseconds added to each delay, to avoid thundering herds.
# SYNC_SCHEDULE_JITTER_MS=0
# Exit after this many consecutive failures so a supervisor can restart or
# alert. 0 (default) never exits. Most useful for catching expired credentials.
# SYNC_SCHEDULE_MAX_FAILURES=0
