# Host paths are mounted into the container; do not use VAULT_PATH here.
HOST_VAULT_PATH=/absolute/path/to/your/Obsidian/vault
HOST_RULES_CONFIG_PATH=/absolute/path/to/your/config.json

# Microsoft Graph application credentials
GRAPH_CLIENT_ID=your-app-client-id
GRAPH_TENANT_ID=your-tenant-id

# Optional sync behavior
ONEDRIVE_FOLDER=ObsidianPublished
HEALTH_PORT=8080
LOG_LEVEL=info
DEBOUNCE_DELAY=300
