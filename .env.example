# Obsidian Copilot Knowledge Publisher Configuration

# Path to the Obsidian vault to monitor
VAULT_PATH=/path/to/obsidian/vault

# Path where published notes will be stored
OUTPUT_PATH=./output

# Destination folder in OneDrive. This is a OneDrive-relative path, not a local path.
ONEDRIVE_FOLDER=ObsidianPublished

# Path to rules configuration file (relative to current directory)
RULES_CONFIG=./config/rules.json

# Logging level: debug, info, warn, error
LOG_LEVEL=info

# File change debounce delay in milliseconds (300-500ms recommended)
DEBOUNCE_DELAY=300

# Optional: Custom ignore patterns (comma-separated glob patterns).
# WARNING: this REPLACES the built-in defaults (.git/**, .obsidian/**, .trash/**,
# node_modules/**, Templates/**, .DS_Store). Prefer EXTRA_IGNORE_PATTERNS below.
# IGNORE_PATTERNS=.git/**,.obsidian/**,node_modules/**

# Optional: Additional ignore patterns appended to the defaults (comma-separated).
# EXTRA_IGNORE_PATTERNS=**/*.bookmark.md,Archive/**

# Port for the health endpoint in watch mode. Change this if 8080 is already
# in use on your machine.
HEALTH_PORT=8080

# Poll for file changes instead of using native filesystem events. Required when
# the vault is a Docker bind mount on macOS or Windows.
# WATCH_USE_POLLING=false
# WATCH_POLL_INTERVAL=1000

# Optional: run a full sync on a fixed interval, in addition to (or instead of)
# watching. Empty means no schedule. Accepts ms, s, m, h, d — e.g. 15m, 1h, 1d.
# SYNC_SCHEDULE=1h
# Run once at startup rather than waiting a full interval (default true).
# SYNC_SCHEDULE_RUN_ON_START=true
# Skip a tick that lands while the previous run is still going (default true).
# SYNC_SCHEDULE_SKIP_IF_RUNNING=true
# Random 0..n milliseconds added to each delay, to avoid thundering herds.
# SYNC_SCHEDULE_JITTER_MS=0
# Exit after this many consecutive failures so a supervisor can restart or
# alert. 0 (default) never exits. Most useful for catching expired credentials.
# SYNC_SCHEDULE_MAX_FAILURES=0
